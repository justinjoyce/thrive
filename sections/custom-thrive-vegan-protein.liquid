{{ 'custom-thrive-product-switcher.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "t:sections.custom-thrive-vegan-protein.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image-product-info-mask",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-product-info-mask.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-back",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-mixed-berries-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-back",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-iced-vanilla-chai-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-info",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-mixed-berries-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-info",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-iced-vanilla-chai-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-product-icon",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-product-icon.label"
    },
    {
      "type": "image_picker",
      "id": "image-product-action-shot",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-product-action-shot.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-front",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-mixed-berries-product-front.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-front",
      "label": "t:sections.custom-thrive-vegan-protein.settings.image-iced-vanilla-chai-product-front.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-thrive-vegan-protein.presets.name"
    }
  ]
}
{% endschema %}
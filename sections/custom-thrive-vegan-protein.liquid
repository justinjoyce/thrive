{{ 'custom-thrive-vegan-protein.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">

    {%- if section.settings.image-product-info-mask != blank -%}

      <div class="thrive-info" style="background-image: url('{{ section.settings.image-product-info-mask | image_url }}')">
        <div class="product-back">
          <img id="flavor-back" src="{{ section.settings.image-cookie-crumble-product-back | image_url }}" alt="Thrive PlantCo. Vegan Protein - Product Back">
        </div>
        <div class="info-left">
          <div>
            <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
            <h2>Gluten-Free</h2>
            <p>Soy-free, dairy-free, cholesterol-free, non-GMO</p>
          </div>
          <div>
            <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
            <h2>Minimal Ingredients</h2>
            <p>Naturally flavored and free of artificial sweeteners to aid digestion</p>
          </div>
        </div>
        <div class="info-right">
          <div>
            <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
            <h2>Environmentally Conscious</h2>
            <p>This bag is made from 100% recyclable material to cut down on waste</p>
          </div>
          <div>
            <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
            <h2>Organic Protein</h2>
            <p>Golden pea protein isolate is highly bio-available to support muscle growth</p>
          </div>
        </div>
      </div>

      <div id="thrive-button-wrapper" class="thrive-product-swap">
        <button class="thrive-button selected blue" data-flavor="cookie-crumble" data-back="{{ section.settings.image-cookie-crumble-product-back | image_url }}" data-info="{{ section.settings.image-cookie-crumble-product-info | image_url }}">Cookie Crumble</button>
        <button class="thrive-button blue" data-flavor="chocolate" data-back="{{ section.settings.image-chocolate-product-back | image_url }}" data-info="{{ section.settings.image-chocolate-product-info | image_url }}">Chocolate</button>
        <button class="thrive-button blue" data-flavor="vanilla" data-back="{{ section.settings.image-vanilla-product-back | image_url }}" data-info="{{ section.settings.image-vanilla-product-info | image_url }}">Vanilla</button>
        <button class="thrive-button blue" data-flavor="banana-bread" data-back="{{ section.settings.image-banana-bread-product-back | image_url }}" data-info="{{ section.settings.image-banana-bread-product-info | image_url }}">Banana Bread</button>
      </div>

      <div class="thrive-product-info">
        <div>
          <img id="flavor-info" src="{{ section.settings.image-cookie-crumble-product-info | image_url }}" alt="Thrive PlantCo. Vegan Protein - Product Back">
        </div>
        <div>
          <h2>Protein assists in the repair and building of lean muscle tissue when combined with regular exercise and a healthy balanced diet.</h2>
          <p class="paragraph">Each serving of Vegan Protein yields an impressive 25g of protein derived from a single source of protein - organic golden pea protein isolate. Pea protein isolate is highly bio-available as it is easily digested and absorbed by the body. In fact, studies have found pea protein isolate to have a digestion rate upwards of 90%. It has also been found to perform equally well for muscle growth and retention when compared to whey protein.</p>
        </div>
      </div>

    {%- endif -%}

    {%- if section.settings.image-product-action-shot != blank -%}

      <div class="thrive-action-shot" style="background-image: url('{{ section.settings.image-product-action-shot | image_url }}')">
        <div>
          <h2>A source of protein & amino acids for maintenance of good health</h2>
        </div>
      </div>

    {%- endif -%}

    <div class="thrive-advice">
      <div>
        <h2>Each batch is rigorously tested for purity and protein concentration to ensure each scoop delivers exactly what is listed on the label. You'll find no fillers or amino acid spiking here!</h2>
      </div>
    </div>

    <div class="thrive-flavors">
      <h2 class="heading2">4 Delicious Flavours</h2>
      <p class="paragraph">Naturally Flavoured</p>
      <div class="thrive-container">
        {%- if section.settings.image-cookie-crumble-product-front != blank -%}
        <div>
          <p class="paragraph">Cookie Crumble</p>
          <img src="{{ section.settings.image-cookie-crumble-product-front | image_url }}" alt="Thrive PlantCo. Vegan Protein - Cookie Crumble Product Front">
        </div>
        {%- endif -%}
        {%- if section.settings.image-chocolate-product-front != blank -%}
        <div>
          <p class="paragraph">Chocolate</p>
          <img src="{{ section.settings.image-chocolate-product-front | image_url }}" alt="Thrive PlantCo. Vegan Protein - Chocolate Product Front">
        </div>
        {%- endif -%}
        {%- if section.settings.image-vanilla-product-front != blank -%}
          <div>
            <p class="paragraph">Vanilla</p>
            <img src="{{ section.settings.image-vanilla-product-front | image_url }}" alt="Thrive PlantCo. Vegan Protein - Vanilla Product Front">
          </div>
        {%- endif -%}
        {%- if section.settings.image-banana-bread-product-front != blank -%}
          <div>
            <p class="paragraph">Banana Bread</p>
            <img src="{{ section.settings.image-banana-bread-product-front | image_url }}" alt="Thrive PlantCo. Vegan Protein - Banana Bread Product Front">
          </div>
        {%- endif -%}
      </div>
      <div class="thrive-container">
        <div>
          <span>25G</span>Vegan Protein
        </div>
        <div>
          <span>0G</span>Sugar
        </div>
        <div>
          <span>20</span>Servings
        </div>
      </div>
      <p><small>* Chocolate contains 1 g of naturally occurring sugar from the cocoa</small></p>
    </div>

    <div class="thrive-reviews">
      <h1>Reviews</h1>
    </div>
  </div>
</div>

{{ 'custom-thrive-product-switcher.js' | asset_url | script_tag }}


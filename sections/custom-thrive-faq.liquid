{{ 'custom-thrive-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">

    <div class="thrive-faq">
      <h1>Frequently Asked Questions</h1>
    </div>

    <div class="thrive-container center closing-statement">
      <p class="paragraph">At Thrive Plant Co., we want to do everything we can to ensure that you love our products and have a great shopping experience. To help you feel confident in your purchase, we have put together a list of frequently asked questions. If you have a question that isn't answered below, please feel free to email us - our team is happy to help!</p>
    </div>

    <div class="thrive-container">

      <hr>

      <nav class="accordion arrows">

        <header class="box">
          <label for="acc-close" class="box-title">Ordering</label>
        </header>

        <input type="radio" name="accordion" id="cb1"/>
        <section class="box">
          <label class="box-title" for="cb1">What methods of payment do you accept?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">We accept VISA, Mastercard, and American Express at the moment.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb2"/>
        <section class="box">
          <label class="box-title" for="cb2">Is your site secure?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Our site is hosted with Shopify using SSL certificates to encrypt our store's content with HTTPS instead of just HTTP. Shopify is PCI level 1 compliant for credit-card processing, which means that it adheres to the highest standards of server compliance.<br><br>Shopify's compliance covers all six PCI standard categories and applies to every store using their platform, which includes the following:</p>
            <ol>
              <li>Maintaining a safe network.</li>
              <li>Credit card data protection.</li>
              <li>Maintaining a vulnerability management program.</li>
              <li>Implementing strong access control measures.</li>
              <li>Regularly monitoring and testing networks.</li>
              <li>Maintaining an information security policy.</li>
            </ol>
          </div>
        </section>

        <header class="box" id="shipping">
          <label for="acc-close" class="box-title">Shipping</label>
        </header>

        <input type="radio" name="accordion" id="cb3"/>
        <section class="box">
          <label class="box-title" for="cb3">Where do you ship?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Currently, we only ship within Canada and do not accept international orders.  Sorry for the inconvenience.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb3_1"/>
        <section class="box">
          <label class="box-title" for="cb3_1">How is my order shipped?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">All orders are shipped via Canada Post and FREE SHIPPING over $79 (Before taxes and after discount/promo codes) will ship Expedited Parcel. You can also upgrade to Xpresspost for faster delivery for an additional fee.</p>
            <p class="paragraph">Canada Post will leave the order in the customer's mail receptacle and if the order will not fit, an attempt to deliver to your door will occur.  If not one is available to receive the order, a Delivery Notice Card will be left with the address of the designated post office for pick up.  Unfortunately, due to the high theft rate within the delivery industry, this protocol has been implemented. Sorry for any inconvenience.</p>
            <p class="paragraph">We reserve the right to refuse any order.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb4"/>
        <section class="box">
          <label class="box-title" for="cb4">How much is shipping?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Shipping is FREE within Canada for orders over $79 before taxes and after discount/promo codes. We provide trackable shipping and orders are shipped via Canada Post Expedited Parcel.</p>
            <p class="paragraph">You can select Xpresspost for faster delivery for an additional fee based on the order weight and delivery location.</p>
            <p class="paragraph">Orders under $79 will be charged depending on what delivery service option you select from the Canada Post live rates.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb5"/>
        <section class="box">
          <label class="box-title" for="cb5">When will I receive my order?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Deliveries made within Canada will take 2 to 9 business days depending on where you live in the country.  You will receive a notification in your inbox as soon as your order leaves our warehouse. Weekends and holidays do not count as shipping days.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb6"/>
        <section class="box">
          <label class="box-title" for="cb6">Where does my order ship from?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Orders ship from our fulfillment center in Windsor, Ontario, Canada.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb7"/>
        <section class="box">
          <label class="box-title" for="cb7">How can I track my order?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Tracking information will be emailed to you after your order has shipped. You will also receive real-time shipping updates and tracking information via email.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="cb8"/>
        <section class="box">
          <label class="box-title" for="cb8">Do I have to pay sales tax?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Yes, all orders are subject to a 5% GST, 9.975% QST or 13-15% HST depending on which province you live.</p>
          </div>
        </section>

        <header class="box">
          <label for="acc-close" class="box-title">Return Policy</label>
        </header>

        <input type="radio" name="accordion" id="cb9"/>
        <section class="box">
          <label class="box-title" for="cb9">What is your return policy?</label>
          <label class="box-close" for="acc-close"></label>
          <div class="box-content">
            <p class="paragraph">Please contact us at <a href="mailto:help@thriveplantco.com">help@thriveplantco.com</a> to start the return process. We will not refund orders unless we are first contacted. This allows us to review the problem and determine how to best address the issues. Please be sure to include your order number in your email.
            </p>
            <p class="paragraph">Returns must be made within 30 days of purchase and all products must be SEALED. A refund will be issued, subtracting the postage incurred by us from the selected shipper, whether the order was over or under $69. Your return is also subjected to a 15% restocking fee.</p>
            <p class="paragraph">For any damages, please take a picture and forward it to us in your email for our review. Please be sure to include your order number.</p>
            <p class="paragraph">It will take 4 - 6 business days to process a return after it arrives at our distribution center. You will receive an email confirmation once your return has been received.</p>
          </div>
        </section>

        <input type="radio" name="accordion" id="acc-close"/>

      </nav>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-thrive-faq.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        },
        {
          "value": "inverse",
          "label": "t:sections.all.colors.inverse.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-thrive-faq.presets.name"
    }
  ]
}
{% endschema %}
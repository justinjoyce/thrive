{{ 'custom-thrive-good-greens.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">

    {%- if section.settings.image-product-info-mask != blank -%}

    <div class="thrive-info" style="background-image: url('{{ section.settings.image-product-info-mask | image_url }}')">
      <div class="product-back">
        <img id="flavor-back" src="{{ section.settings.image-iced-vanilla-chai-product-back | image_url }}" alt="Thrive PlantCo. Good Greens - Iced Vanilla Chai Product Back">
      </div>
      <div class="info-left">
        <div>
          <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
          <h2>Gluten-Free</h2>
          <p>Soy-free, dairy-free, non-GMO</p>
        </div>
        <div>
          <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
          <h2>47 Premium Superfoods</h2>
          <p>Boost your daily micronutrient intake for overall health</p>
        </div>
      </div>
      <div class="info-right">
        <div>
          <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
          <h2>Environmentally Conscious</h2>
          <p>This bag is made from 100% recyclable material to cut down on waste</p>
        </div>
        <div>
          <img src="{{ section.settings.image-product-icon | image_url }}" width="50" height="50" alt="">
          <h2>Natural Ingredients</h2>
          <p>Naturally sweetened with stevia leaf extract for great taste</p>
        </div>
      </div>
    </div>

    <div id="thrive-button-wrapper" class="thrive-product-swap">
      <button class="thrive-button selected green" data-flavor="iced-vanilla-chai" data-back="{{ section.settings.image-iced-vanilla-chai-product-back | image_url }}" data-info="{{ section.settings.image-iced-vanilla-chai-product-info | image_url }}">Iced Vanilla Chai</button>
      <button class="thrive-button green" data-flavor="mixed-berries" data-back="{{ section.settings.image-mixed-berries-product-back | image_url }}" data-info="{{ section.settings.image-mixed-berries-product-info | image_url }}">Mixed Berries</button>
    </div>

    <div class="thrive-product-info">
      <img id="flavor-info" src="{{ section.settings.image-iced-vanilla-chai-product-info | image_url }}" alt="Thrive PlantCo. Good Greens - Iced Vanilla Chai Product Back">
    </div>

    <div class="thrive-product-notes">
      <div>
        <h2>Good Greens provides antioxidants for the maintenance of good health</h2>
      </div>
      <div>
        <p class="paragraph">Good Greens contains 47 different superfoods to ensure each serving is packed full of micronutrients and antioxidants to promote optimal health and well-being on a daily basis.</p>
        <p class="paragraph">The list of ingredients may be long, but it's full of familiar items, from fruits and vegetables, to green tea and herbs. The blend of natural ingredients, natural flavours, and stevia leaf extract has been carefully balanced for a great tasting greens product our consumers will want to enjoy as part of their daily routine.</p>
      </div>
    </div>

    {%- endif -%}

    {%- if section.settings.image-product-action-shot != blank -%}

    <div class="thrive-action-shot" style="background-image: url('{{ section.settings.image-product-action-shot | image_url }}')">
      <div>
        <h2>Antioxidants protect against the oxidative effects caused by free radicals</h2>
      </div>
    </div>

    {%- endif -%}

    <div class="thrive-advice">
      <div>
        <h2>Life is hectic, and it can be a challenge to hit your micronutrients every day - we get it. Good Greens solves this problem, in one simple tablespoon.</h2>
      </div>
    </div>

    {%- if section.settings.image-iced-vanilla-chai-product-front != blank and section.settings.image-mixed-berries-product-front != blank -%}

    <div class="thrive-flavors">
      <h2 class="heading2">2 Delicious Flavours</h2>
      <p class="paragraph">Naturally Flavoured</p>
      <div class="thrive-container">
        <div>
          <p class="paragraph">Iced Vanilla Chai</p>
          <img src="{{ section.settings.image-iced-vanilla-chai-product-front | image_url }}" alt="Thrive PlantCo. Good Greens - Iced Vanilla Chai Product Front">
        </div>
        <div>
          <p class="paragraph">Mixed Berries</p>
          <img src="{{ section.settings.image-mixed-berries-product-front | image_url }}" alt="Thrive PlantCo. Good Greens - Iced Vanilla Chai Product Back">s
        </div>
      </div>
      <div class="thrive-container">
        <div>
          <span>100%</span>Vegan
        </div>
        <div>
          <span>0</span>Fillers
        </div>
        <div>
          <span>40</span>Servings
        </div>
      </div>
    </div>

    {%- endif -%}

    <div class="thrive-reviews">
      <h1>Reviews</h1>
    </div>
  </div>
</div>

{{ 'custom-thrive-product-switcher.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "t:sections.custom-thrive-good-greens.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image-product-info-mask",
      "label": "t:sections.custom-thrive-good-greens.settings.image-product-info-mask.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-back",
      "label": "t:sections.custom-thrive-good-greens.settings.image-mixed-berries-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-back",
      "label": "t:sections.custom-thrive-good-greens.settings.image-iced-vanilla-chai-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-info",
      "label": "t:sections.custom-thrive-good-greens.settings.image-mixed-berries-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-info",
      "label": "t:sections.custom-thrive-good-greens.settings.image-iced-vanilla-chai-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-product-icon",
      "label": "t:sections.custom-thrive-good-greens.settings.image-product-icon.label"
    },
    {
      "type": "image_picker",
      "id": "image-product-action-shot",
      "label": "t:sections.custom-thrive-good-greens.settings.image-product-action-shot.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-front",
      "label": "t:sections.custom-thrive-good-greens.settings.image-mixed-berries-product-front.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-front",
      "label": "t:sections.custom-thrive-good-greens.settings.image-iced-vanilla-chai-product-front.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-thrive-good-greens.presets.name"
    }
  ]
}
{% endschema %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.custom-thrive-good-greens.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image-product-info-mask",
      "label": "t:sections.custom-thrive-good-greens.settings.image-product-info-mask.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-back",
      "label": "t:sections.custom-thrive-good-greens.settings.image-mixed-berries-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-back",
      "label": "t:sections.custom-thrive-good-greens.settings.image-iced-vanilla-chai-product-back.label"
    },
    {
      "type": "image_picker",
      "id": "image-mixed-berries-product-info",
      "label": "t:sections.custom-thrive-good-greens.settings.image-mixed-berries-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-iced-vanilla-chai-product-info",
      "label": "t:sections.custom-thrive-good-greens.settings.image-iced-vanilla-chai-product-info.label"
    },
    {
      "type": "image_picker",
      "id": "image-product-action-shot",
      "label": "t:sections.custom-thrive-good-greens.settings.image-product-action-shot.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-thrive-good-greens.presets.name"
    }
  ]
}
{% endschema %}